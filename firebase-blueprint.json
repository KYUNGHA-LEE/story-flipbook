{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Metadata for a flipbook",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the book"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "authorUid": {
          "type": "string",
          "description": "UID of the creator"
        }
      },
      "required": ["title", "createdAt"]
    },
    "Page": {
      "title": "Page",
      "description": "A single page in a flipbook",
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "description": "The order of the page"
        },
        "imageData": {
          "type": "string",
          "description": "Base64 encoded image data or URL"
        }
      },
      "required": ["pageNumber", "imageData"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Collection of flipbooks"
    },
    "/books/{bookId}/pages/{pageId}": {
      "schema": "Page",
      "description": "Subcollection of pages for a specific book"
    }
  }
}
